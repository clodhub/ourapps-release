# Android unit tests, only when the Android project or the shared fixtures change or when started by hand. Gradle downloads
# are cached. With androidCheck, the debug build is started in an emulator against the server started on the runner and
# driven until the given text is on screen.
name: ci-android

on:
  push:
    branches: [main]
    paths:
      - "@@androidDir@@/**"
      - "@@fixturesDir@@/**"
      - ".github/workflows/ci-android.yml"
  pull_request:
    paths:
      - "@@androidDir@@/**"
      - "@@fixturesDir@@/**"
      - ".github/workflows/ci-android.yml"
  workflow_dispatch:

# A newer push replaces a check still running.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  android:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "@@java@@"
          cache: gradle
      - run: test -x ./gradlew || gradle wrapper --no-daemon
        working-directory: @@androidDir@@
      - run: ./gradlew --no-daemon -q testDebugUnitTest
        working-directory: @@androidDir@@
@@if androidcheck@@
      - uses: actions/setup-node@v4
        with:
          node-version: "@@node@@"
      # 10.0.2.2 is the runner itself as the emulator sees it.
      - run: ./gradlew --no-daemon -q assembleDebug -PserverUrl=http://10.0.2.2:8788
        working-directory: @@androidDir@@
      - name: Start the server
        working-directory: @@serverDir@@
        run: |
          npm ci
          (PORT=8788 HOST=127.0.0.1 DATA_DIRECTORY="$RUNNER_TEMP/rooms" npm start > "$RUNNER_TEMP/server.log" 2>&1 &)
          for _ in $(seq 60); do curl -fs http://127.0.0.1:8788/health && break; sleep 1; done
          curl -fsS http://127.0.0.1:8788/health
      - name: Enable the emulator's hardware acceleration
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm
      - uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: 36
          target: google_apis
          arch: x86_64
          profile: pixel_7
          disable-animations: true
          emulator-options: -no-window -no-audio -no-snapshot -no-boot-anim -camera-back none
          working-directory: @@androidDir@@
          script: python3 "$GITHUB_WORKSPACE/@@scripts@@/android_screen.py" app/build/outputs/apk/debug/app-debug.apk @@androidCheckArgs@@ --shot "$RUNNER_TEMP/android-check.png"
      - name: Stop the local servers
        if: always()
        run: |
          mapfile -t pids < <(lsof -t -sTCP:LISTEN -i tcp:8788 || true)
          if (( ${#pids[@]} )); then kill "${pids[@]}"; fi
      - if: always()
        uses: actions/upload-artifact@v4
        with:
          name: android-check
          path: |
            ${{ runner.temp }}/android-check.png
            ${{ runner.temp }}/server.log
          if-no-files-found: ignore
@@end@@
