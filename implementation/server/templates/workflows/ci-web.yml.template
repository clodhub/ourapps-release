# Web type check and build, only when the web application changes or when started by hand. With a server folder, the
# application's browser check (test/browser.mjs in the web folder, when there is one) plays against the server started
# on the runner in headless Chrome.
name: ci-web

on:
  push:
    branches: [main]
    paths:
      - "@@webDir@@/**"
@@if server@@
      - "@@serverDir@@/**"
@@end@@
      - ".github/workflows/ci-web.yml"
  pull_request:
    paths:
      - "@@webDir@@/**"
@@if server@@
      - "@@serverDir@@/**"
@@end@@
      - ".github/workflows/ci-web.yml"
  workflow_dispatch:

# A newer push replaces a check still running.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  web:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    defaults:
      run:
        working-directory: @@webDir@@
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "@@node@@"
          cache: npm
          cache-dependency-path: @@webDir@@/package-lock.json
      - run: npm ci
      - run: npx tsc --noEmit && npx vite build
@@if server@@
      - name: Start the server and serve the web client built against it
        if: hashFiles('@@webDir@@/test/browser.mjs') != ''
        run: |
          (cd "$GITHUB_WORKSPACE/@@serverDir@@" && npm ci && (PORT=8788 HOST=127.0.0.1 DATA_DIRECTORY="$RUNNER_TEMP/rooms" npm start > "$RUNNER_TEMP/server.log" 2>&1 &))
          for _ in $(seq 60); do curl -fs http://127.0.0.1:8788/health && break; sleep 1; done
          curl -fsS http://127.0.0.1:8788/health
          VITE_SERVER=http://127.0.0.1:8788 npx vite build --outDir "$RUNNER_TEMP/web-check-dist"
          (npx vite preview --outDir "$RUNNER_TEMP/web-check-dist" --host 127.0.0.1 --port 5173 --strictPort > "$RUNNER_TEMP/preview.log" 2>&1 &)
          for _ in $(seq 30); do curl -fs -o /dev/null http://127.0.0.1:5173/ && break; sleep 1; done
          curl -fsS -o /dev/null http://127.0.0.1:5173/
      - name: Browser check
        if: hashFiles('@@webDir@@/test/browser.mjs') != ''
        run: |
          WEB_CHECK_URL=http://127.0.0.1:5173/ WEB_CHECK_SERVER=http://127.0.0.1:8788 WEB_CHECK_OUT="$RUNNER_TEMP/web-check" \
            CHROME="$(command -v google-chrome)" node test/browser.mjs
      - if: always() && hashFiles('@@webDir@@/test/browser.mjs') != ''
        uses: actions/upload-artifact@v4
        with:
          name: web-check
          path: |
            ${{ runner.temp }}/web-check/*.png
            ${{ runner.temp }}/server.log
          if-no-files-found: ignore
@@end@@
